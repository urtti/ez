{
  "aliases" : {
    "bump-version" : {
      "commands" : [
        "sed -i \"\" \"s\/private let VERSION = \\\"v[^\\\"]*\\\"\/private let VERSION = \\\"v{1}\\\"\/\" ezcli\/ez.swift && grep \"private let VERSION\" ezcli\/ez.swift"
      ],
      "description" : "Bump ez version",
      "executionType" : "sequential"
    },
    "install-local" : {
      "commands" : [
        "brew unlink ez && swift build -c release && codesign --force --sign {EZ_CODESIGN_IDENTITY} .build\/release\/ez && sudo cp .build\/release\/ez \/usr\/local\/bin\/"
      ],
      "executionType" : "sequential"
    },
    "install-brew" : {
      "executionType" : "sequential",
      "commands" : [
        "rm \/usr\/local\/bin\/ez && brew link ez"
      ]
    },
    "test" : {
      "commands" : [
        ".\/acceptance-test.sh"
      ],
      "executionType" : "sequential"
    },
    "downloads" : {
      "executionType" : "sequential",
      "commands" : [
        "curl -s https:\/\/api.github.com\/repos\/urtti\/homebrew-ez\/releases | jq '.[] | {tag: .tag_name, assets: [.assets[] | {name: .name, count: .download_count}]}'"
      ]
    }
  }
}
